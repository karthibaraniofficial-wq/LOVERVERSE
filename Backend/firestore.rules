rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Relationships
    match /relationships/{relationshipId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
    }

    // Shared Worlds
    match /worlds/{worldId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid in resource.data.ownerIds;
    }

    // Inventories (Validated server-side only)
    match /inventories/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Server-only modification
    }

    // Shared Memories
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
